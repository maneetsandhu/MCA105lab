#include<iostream>
using namespace std;
int main(){
int arr[100], size = 0, choice, i, val, pos, found;
while(true){
cout << "\n1.Create 2.Display 3.Insert 4.Delete 5.Search 6.Exit\nEnter choice: ";
cin >> choice;
switch (choice) {
case 1:
cout << "Enter size: "; cin >> size;
cout << "Enter " << size << " elements: ";
for (i = 0; i < size; i++) cin >> arr[i];
break;
case 2: 
cout << "Array: ";
for (i = 0; i < size; i++) cout << arr[i] << " ";
cout << endl;
break;
case 3: 
cout << "Enter element and position: "; cin >> val >> pos;
for (i = size; i > pos; i--) arr[i] = arr[i - 1];
arr[pos] = val;
size++;
break;
case 4: 
cout << "Enter position to delete: "; cin >> pos;
cout << "Deleted: " << arr[pos] << endl;
for (i = pos; i < size - 1; i++) arr[i] = arr[i + 1]; 
size--;
break;
case 5:
cout << "Enter element to search: "; cin >> val;
found = -1;
for (i = 0; i < size; i++) {
if (arr[i] == val) { found = i; break; }
}
if (found != -1) cout << "Found at index " << found << endl;
else cout << "Not found" << endl;
break;
case 6: 
return 0;
}
}
}



